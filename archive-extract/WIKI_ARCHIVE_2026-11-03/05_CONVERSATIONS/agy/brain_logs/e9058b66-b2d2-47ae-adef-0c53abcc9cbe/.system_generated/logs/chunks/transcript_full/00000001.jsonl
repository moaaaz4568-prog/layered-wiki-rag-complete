: \n21: CHINESE_RE = re.compile(r\"[\\u4e00-\\u9fff]\")\n22: DEFAULT_ROOT = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))\n23: DEFAULT_EXTS = (\".md\", \".txt\", \".tsv\", \".py\")\n24: \n25: \n26: def iter_files(root, exts):\n27:     \"\"\"يمشي على الشجرة ويعيد مسارات الملفات المطابقة للامتدادات.\"\"\"\n28:     if os.path.isfile(root):\n29:         yield root\n30:         return\n31:     for dirpath, dirnames, filenames in os.walk(root):\n32:         dirnames[:] = [d for d in dirnames if not d.startswith(\".\")]\n33:         for name in sorted(filenames):\n34:             if name.startswith(\".\"):\n35:                 continue\n36:             if exts and not name.lower().endswith(tuple(exts)):\n37:                 continue\n38:             yield os.path.join(dirpath, name)\n39: \n40: \n41: def smart_score(line, term):\n42:     \"\"\"تقييم ذكي للسطر: تطابق كلمة كاملة أقوى من تطابق جزئي، وتكرار يرفع الدرجة.\"\"\"\n43:     score = 0\n44:     lowered = line.lower()\n45:     t = term.lower()\n46:     # تطابق كلمة كاملة (Word Boundary) — أدق دلالياً\n47:     score += 3 * len(re.findall(r\"\\b\" + re.escape(t) + r\"\\b\", lowered))\n48:     # تطابق جزئي (Substring) — يلتقط المشتقات\n49:     score += 1 * lowered.count(t)\n50:     return score\n51: \n52: \n53: def search(root, term, context=2, max_results=20, exts=DEFAULT_EXTS, min_score=1):\n54:     \"\"\"بحث بالمصطلح: يعيد قائمة نتائج (ملف، سطر، درجة، مقطع).\"\"\"\n55:     results = []\n56:     for path in iter_files(root, exts):\n57:         try:\n58:             with open(path, \"r\", encoding=\"utf-8\", errors=\"replace\") as fh:\n59:                 lines = fh.readlines()\n60:         except OSError:\n61:             continue\n62:         hits = []\n63:         for idx, raw in enumerate(lines, start=1):\n64:             s = smart_score(raw, term)\n65:             if s >= min_score:\n66:                 hits.append((idx, s, raw.rstrip(\"\\n\")))\n67:         if not hits:\n68:             continue\n69:         for idx, s, text in hits:\n70:             start = max(1, idx - context)\n71:             end = min(len(lines), idx + context)\n72:             snippet = \"\".join(lines[start - 1:end]).rstrip(\"\\n\")\n73:             if len(snippet) > 400:\n74:                 snippet = snippet[:397] + \"...\"\n75:             results.append({\n76:                 \"file\": path, \"line\": idx, \"score\": s, \"text\": text.strip()[:200],\n77:                 \"snippet\": snippet,\n78:             })\n79:     results.sort(key=lambda r: (-r[\"score\"], r[\"file\"], r[\"line\"]))\n80:     return results[:max_results]\n81: \n82: \n83: def selftest():\n84:     \"\"\"اختبار ذاتي: بحث تجريبي داخل مجلد النسخة نفسها.\"\"\"\n85:     root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\n86:     res = search(root, \"PLAYBOOK\", context=0, max_results=3)\n87:     ok = len(res) >= 3\n88:     print(\"SELFTEST:\", \"PASS\" if ok else \"FAIL\", f\"({len(res)} نتائج)\")\n89:     return 0 if ok else 1\n90: \n91: \n92: def main():\n93:     ap = argparse.ArgumentParser(description=\"nexus_rag — استرجاع محلي stdlib فقط\")\n94:     ap.add_argument(\"term\", nargs=\"?\", help=\"المصطلح المبحوث عنه\")\n95:     ap.add_argument(\"--root\", default=DEFAULT_ROOT, help=\"مجلد الجذر للبحث\")\n96:     ap.add_argument(\"--context\", type=int, default=2, help=\"أسطر السياق حول كل نتيجة\")\n97:     ap.add_argument(\"--max\", type=int, default=20, help=\"أقصى عدد نتائج\")\n98:     ap.add_argument(\"--ext\", nargs=\"*\", default=list(DEFAULT_EXTS), help=\"الامتدادات المسموحة\")\n99:     ap.add_argument(\"--selftest\", action=\"store_true\", help=\"اختبار ذاتي\")\n100:     args = ap.parse_args()\n101: \n102:     if args.selftest:\n103:         sys.exit(selftest())\n104:     if not args.term:\n105:         ap.print_help()\n106:         sys.exit(2)\n107: \n108:     res = search(args.root, args.term, args.context, args.max, tuple(args.ext))\n109:     print(f\"البحث عن: «{args.term}» في {args.root} — النتائج: {len(res)}\")\n110:     for r in res:\n111:         flag = \" [تحذير: حرف صيني]\" if CHINESE_RE.search(r[\"text\"]) else \"\"\n112:         print(f\"\\n--- {r['file']}:{r['line']} (درجة {r['score']}){flag}\")\n113:         print(r[\"snippet\"])\n114:     if not res:\n115:         print(\"لا نتائج — جرّب مصطلحاً آخر أو --root مختلف.\")\n116:     sys.exit(0 if res else 1)\n117: \n118: \n119: if __name__ == \"__main__\":\n120:     main()"}
