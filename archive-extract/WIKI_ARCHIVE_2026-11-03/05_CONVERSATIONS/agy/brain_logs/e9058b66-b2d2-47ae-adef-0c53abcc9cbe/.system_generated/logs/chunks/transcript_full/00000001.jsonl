{"step_index":48,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-25T08:08:24Z","content":"Created At: 2026-10-25T08:08:24Z\nCompleted At: 2026-10-25T08:08:24Z\nShowing lines 1-100 of 1410\n1: #!/usr/bin/env python3\n2: # -*- coding: utf-8 -*-\n3: \"\"\"\n4: V3_SYS :: audit.py — فاحص الجودة الآلي (Quality Gate Auditor)\n5: ==============================================================\n6: \n7: يحوّل كل عيب مكتشف يدويًا إلى فحص قابل للتشغيل الآلي.\n8: \n9: Python 3 · **stdlib فقط** (لا pip ولا أي اعتماد خارجي).\n10: \n11: ------------------------------------------------------------------\n12: البنية\n13: ------------------------------------------------------------------\n14: * ``CHECKERS = {}``  — سجلّ الفواحص: كل فاحص يحمل\n15:   ``id, name, severity(0-10), weight, run(ctx) -> list[Finding]``.\n16:   (``ctx`` يحمل ``ctx.root`` = جذر الفحص، و``ctx.add()`` لإضافة Findings،\n17:    و``ctx.corpus`` لقراءة الملفات مع كاش قراءة واحدة.)\n18: * ``Finding = {id, checker, path, bytes, evidence, severity}``\n19: * واحد فقط من الفواحص يقرأ الملفات فعليًا (``os.walk`` مرة واحدة)،\n20:   والباقي يقرأ من كاش النصوص في الذاكرة.\n21: \n22: ------------------------------------------------------------------\n23: CLI\n24: ------------------------------------------------------------------\n25:   --root PATH            جذر الفحص (إلزامي)\n26:   --checkers C01,C02     تشغيل مجموعة فرعية فقط\n27:   --json OUT.json        تقرير JSON\n28:   --md   OUT.md          تقرير Markdown\n29:   --weight-sum           طباعة الأوزان ومجموعها (يجب = 100) والخروج\n30:   --fail-on SEV          خروج code=1 إذا وُجدت مخالفات بخطورة >= SEV\n31:   --max-examples N       عدد الأمثلة المحفوظة لكل فاحص في التقارير (افتراضي 3)\n32:   --exclude NAME         استبعاد مسار (قابل للتكرار، افتراضيًا .git فقط)\n33:   --quiet                لا تطبع الجدول\n34: \n35: ------------------------------------------------------------------\n36: الأداء\n37: ------------------------------------------------------------------\n38: مسار واحد عبر الشجرة + كاش نصوص بحدّ ذاكرة + إعادة استخدام القراءة\n39: لجميع الفواحص الـ28. لا يقرأ أي فاحص ملفًا بنفسه مرتين.\n40: \"\"\"\n41: \n42: from __future__ import annotations\n43: \n44: import argparse\n45: import hashlib\n46: import json\n47: import os\n48: import re\n49: import sys\n50: import time\n51: from collections import OrderedDict, defaultdict\n52: \n53: # ==================================================================\n54: # 0) أدوات نصية مشتركة\n55: # ==================================================================\n56: \n57: FRONTMATTER_RE = re.compile(r\"\\A\\ufeff?---\\s*\\n(.*?)\\n---\\s*(?:\\n|\\Z)\", re.S)\n58: WIKILINK_RE = re.compile(r\"\\[\\[([^\\[\\]\\n|]+)\")\n59: SECTION_HEADING_RE = re.compile(r\"(?m)^(#{1,6})[ \\t]*(.+?)[ \\t]*#*\\s*$\")\n60: BOLD_LABEL_RE = re.compile(r\"\\*\\*([^*\\n]{2,40})\\*\\*\")\n61: TABLE_ROW_RE = re.compile(r\"(?m)^\\|\\s*`?\\s*\\d\")\n62: CONCEPT_REF_RE = re.compile(r\"Concept_[A-Za-z0-9_]\")\n63: NUM_TOKEN_RE = re.compile(r\"\\d{2,}\\s*%|\\b\\d{2,}\\b\")\n64: CYRILLIC_RE = re.compile(r\"[\\u0400-\\u04FF]\")\n65: FOUR_DIGITS_RE = re.compile(r\"\\d{4}\")\n66: GEN_SUFFIX_RE = re.compile(r\"_v\\d+$\")\n67: GEN_DECIMAL_RE = re.compile(r\"_\\d+\\.\\d+_\")\n68: SECTOR_DIR_RE = re.compile(r\"^(\\d{2})_\")\n69: MASTER_TAIL_RE = re.compile(r\"_(\\d{2})_[a-z0-9_]+$\", re.I)\n70: PLACEHOLDER_RE = re.compile(\n71:     r\"\\bTODO\\b|\\bTBD\\b|\\bXXX\\b|مفهوم استراتيجي في\\s+عالم\\s+الأعمال\"\n72: )\n73: \n74: # الأقسام الستة المطلوبة (C14)\n75: REQUIRED_SECTIONS = [\n76:     (\"التعريف\", (\"التعريف\", \"التعريف الإجرائي\", \"ما هو\")),\n77:     (\"الآلية\", (\"الآلية\", \"آلية العمل\", \"كيف يعمل\")),\n78:     (\"حدود الفناء\", (\"حدود الفناء\", \"الفناء\", \"متى لا يعمل\")),\n79:     (\"الشروط\", (\"الشروط\", \"الشرائح\", \"متى يعمل\")),\n80:     (\"الدليل\", (\"الدليل\", \"الاقتباسات\", \"الشواهد\")),\n81:     (\"المصدرية\", (\"المصدرية\", \"المصادر\", \"المراجع\")),\n82: ]\n83: REQUIRED_SECTION_KEYS = [k for k, _ in REQUIRED_SECTIONS]\n84: \n85: CONCEPT_SECTIONS = (\"التعريف\", \"الآلية\", \"حدود الفناء\", \"الشروط\", \"الدليل\", \"المصدرية\")\n86: TENSION_TOKENS = (\"التوترات\", \"توتر\", \"التعارضات\", \"المقارنات والتعارضات\")\n87: \n88: \n89: # ==================================================================\n90: # 1) كاش الملفات — os.walk واحد + قراءة نصية واحدة\n91: # ==================================================================\n92: \n93: class FileRec:\n94:     \"\"\"سجلّ ملف واحد (بيانات وصفية فقط، بلا نص).\"\"\"\n95: \n96:     __slots__ = (\"path\", \"rel\", \"name\", \"stem\", \"dirname\", \"size\", \"mtime\", \"is_md\")\n97: \n98:     def __init__(self, path, rel, size, mtime):\n99:         self.path = path\n100:         self.rel = rel"}
