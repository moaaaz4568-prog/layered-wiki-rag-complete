{"step_index":99,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-25T08:13:56Z","input_tokens":2536,"cache_read_tokens":78171,"output_tokens":2223,"thinking":"The systems' sizes exceed the expected line count. Now, evaluating the functionality of the provided Python tools. One tool performs intelligent grep-based searching within a specified directory and retrieves contextual snippets.\n\n\nExamining the behavior of the provided Python tools. One tool conducts a search across specified paths and retrieves results relevant to a given query. The search functionality is verified with a sample query \"cold email\" to ensure the tool functions as intended.\n\n\n","tool_calls":[{"name":"write_file","args":{"Content":"#!/usr/bin/env python3\n# -*- coding: utf-8 -*-\n\"\"\"\nnexus_rag.py — اداة استرجاع معرفي ذكية تعمل بالمكتبة القياسية فقط (stdlib).\nالوظيفة: البحث بالمصطلح او العبارة واسترجاع المقاطع السياقية ومسارات الملفات وارقام الاسطر.\nمجلدات البحث الافتراضية:\n  1) مجلد الويكي: /sdcard/wikillm/argon_version/wiki_ver2/\n  2) مجلد المادة الخام: /sdcard/Nexus_Brain/Nexus_Brain/brain/\n\"\"\"\n\nimport argparse\nimport os\nimport re\nimport sys\n\nDEFAULT_ROOTS = [\n    \"/sdcard/wikillm/argon_version/wiki_ver2\",\n    \"/sdcard/Nexus_Brain/Nexus_Brain/brain\",\n]\nDEFAULT_EXTS = (\".md\", \".txt\")\n\n\ndef iter_candidate_files(roots, exts):\n    \"\"\"يمشي عبر المجلدات المحددة ويعيد مسارات الملفات الصالحة.\"\"\"\n    for root in roots:\n        if not os.path.exists(root):\n            continue\n        if os.path.isfile(root):\n            yield root\n            continue\n        for dirpath, dirnames, filenames in os.walk(root):\n            # تجاهل مجلدات النظام والمجلدات المخفية\n            dirnames[:] = [d for d in dirnames if not d.startswith(\".\")]\n            for filename in filenames:\n                if filename.startswith(\".\"):\n                    continue\n                if exts and not filename.lower().endswith(tuple(exts)):\n                    continue\n                yield os.path.join(dirpath, filename)\n\n\ndef calculate_match_score(line, query):\n    \"\"\"تقييم ذكي لقوة تطابق السطر مع عبارة البحث.\"\"\"\n    q_lower = query.lower()\n    line_lower = line.lower()\n    if q_lower not in line_lower:\n        return 0\n    score = 10\n    # تطابق دقيق مع حدود الكلمات\n    pattern = r\"\\b\" + re.escape(q_lower) + r\"\\b\"\n    word_matches = len(re.findall(pattern, line_lower))\n    score += word_matches * 5\n    # مكافأة إذا كان السطر عنوانا\n    if line.strip().startswith(\"#\"):\n        score += 8\n    return score\n\n\ndef search_rag(query, roots=DEFAULT_ROOTS, context=2, max_results=10, exts=DEFAULT_EXTS):\n    \"\"\"تنفيذ البحث واستخراج المقاطع السياقية المصحوبة بالمسار والسطر.\"\"\"\n    results = []\n    for filepath in iter_candidate_files(roots, exts):\n        try:\n            with open(filepath, \"r\", encoding=\"utf-8\", errors=\"replace\") as f:\n                lines = f.readlines()\n        except OSError:\n            continue\n\n        for idx, line in enumerate(lines, start=1):\n            score = calculate_match_score(line, query)\n            if score > 0:\n                start_line = max(1, idx - context)\n                end_line = min(len(lines), idx + context)\n                snippet_lines = lines[start_line - 1:end_line]\n                snippet = \"\".join(snippet_lines).rstrip()\n                results.append({\n                    \"path\": filepath,\n                    \"line\": idx,\n                    \"score\": score,\n                    \"match_line\": line.strip(),\n                    \"snippet\": snippet,\n                })\n\n    # ترتيب النتائج تنازليا حسب درجة التطابق\n    results.sort(key=lambda r: (-r[\"score\"], r[\"path\"], r[\"line\"]))\n    return results[:max_results]\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"nexus_rag — اداة الاسترجاع المعرفي الذكي\")\n    parser.add_argument(\"query\", nargs=\"?\", default=\"cold email\", help=\"عبارة او مصطلح البحث\")\n    parser.add_argument(\"--roots\", nargs=\"*\", default=DEFAULT_ROOTS, help=\"جذور البحث على القرص\")\n    parser.add_argument(\"--context\", type=int, default=2, help=\"عدد اسطر السياق المحيطة\")\n    parser.add_argument(\"--max\", type=int, default=10, help=\"الحد الاقصى لعدد النتائج\")\n    parser.add_argument(\"--exts\", nargs=\"*\", default=list(DEFAULT_EXTS), help=\"الامتدادات المفحوصة\")\n\n    args = parser.parse_args()\n\n    results = search_rag(\n        query=args.query,\n        roots=args.roots,\n        context=args.context,\n        max_results=args.max,\n        exts=args.exts,\n    )\n\n    if not results:\n        print(f\"لم يتم العثور على نتائج تطابق: «{args.query}»\")\n        sys.exit(1)\n\n    for i, r in enumerate(results, 1):\n        print(f\"--- النتيجة {i}: {r['path']}:{r['line']} (الدرجة: {r['score']}) ---\")\n        print(r[\"snippet\"])\n        print()\n\n\nif __name__ == \"__main__\":\n    main()\n","Overwrite":true,"Path":"/sdcard/wikillm/argon_version/wiki_ver2/tools/nexus_rag.py"}}]}
