echo "--- file count (ls-tree -r) ---"
git ls-tree -r --name-only HEAD | wc -l
echo "--- file count (find) ---"
find . -path ./.git -prune -o -type f -print | wc -l

# --- Credential helper via GIT_ASKPASS: reads token file directly, token never appears in command line or URL ---
cat > /tmp/opencode/.askpass <<'EOS'
#!/bin/sh
cat /tmp/opencode/gh_tok.txt
EOS
chmod +x /tmp/opencode/.askpass

echo "=== PUSH (credential via askpass, output redacted) ==="
PUSH_TMP=/tmp/opencode/push_out.txt
: > "$PUSH_TMP"
GIT_ASKPASS=/tmp/opencode/.askpass GIT_TERMINAL_PROMPT=0 git push origin main 2>&1 | sed -E 's/(x-access-token:)[A-Za-z0-9_\-]+/\1[REDACTED]/g; s/(ghp_|github_pat_)[A-Za-z0-9_]+/\1[REDACTED]/g' > "$PUSH_TMP"
PUSH_RC=${PIPESTATUS[0]}
echo "push_rc=$PUSH_RC"
cat "$PUSH_TMP"
echo "=== PUSH OUTPUT TAIL ==="
tail -20 "$PUSH_TMP"

echo "=== AFTER ==="
git status -sb
# Refresh remote tracking (fetch also via askpass, redacted)
GIT_ASKPASS=/tmp/opencode/.askpass GIT_TERMINAL_PROMPT=0 git fetch origin 2>&1 | sed -E 's/(x-access-token:)[A-Za-z0-9_\-]+/\1[REDACTED]/g; s/(ghp_|github_pat_)[A-Za-z0-9_]+/\1[REDACTED]/g' | tail -5
git status -sb
echo "--- HEAD sha / branch ---"
git rev-parse HEAD
git rev-parse --abbrev-ref HEAD
echo "--- remote origin/main sha / root names ---"
git rev-parse origin/main
git ls-tree --name-only origin/main
echo "--- ls-tree -r count HEAD ---"
git ls-tree -r --name-only HEAD | wc -l
echo "--- ls-tree root count HEAD ---"
git ls-tree --name-only HEAD | wc -l

# --- Persist values for report step (no token involved) ---
SHA=$(git rev-parse HEAD)
BR=$(git rev-parse --abbrev-ref HEAD)
FCOUNT=$(git ls-tree -r --name-only HEAD | wc -l)
STATUS_AFTER=$(git status -sb | head -1)
REMOTE_ROOT=$(git ls-tree --name-only origin/main)
PUSH_TAIL=$(tail -20 "$PUSH_TMP")

mkdir -p /workspace/wiki/work
cat > /workspace/wiki/work/upload-report.md <<EOF
# Upload Report

- commit sha: $SHA
- branch: $BR
- file count (git ls-tree -r --name-only HEAD): $FCOUNT
- status after push: $STATUS_AFTER

## Push output tail
\`\`\`
$PUSH_TAIL
\`\`\`

## Remote contents root names (origin/main)
\`\`\`
$REMOTE_ROOT
\`\`\`

secret scan before push: zero matches
EOF
echo "=== REPORT WRITTEN ==="
cat /workspace/wiki/work/upload-report.md
# cleanup temp askpass + push tmp (contain no token; askpass script still references token file — remove it)
rm -f /tmp/opencode/.askpass "$PUSH_TMP"
echo "=== VERIFY report file exists ==="
ls -l /workspace/wiki/work/upload-report.md

